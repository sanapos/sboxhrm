<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SboxPrintAgent</AssemblyName>
    <RootNamespace>SboxPrintAgent</RootNamespace>
    <Version>1.4.6</Version>
    <Product>SBOX Print Agent</Product>
    <Description>SBOX — kết nối máy in và nhận lệnh in từ phần mềm bán hàng</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Bản cho server POS: dotnet publish -p:SboxServer=pos -->
  <PropertyGroup Condition="'$(SboxServer)' == 'pos'">
    <DefineConstants>$(DefineConstants);SBOX_SERVER_POS</DefineConstants>
    <Product>SBOX POS Print Agent</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo.png" />
    <EmbeddedResource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
