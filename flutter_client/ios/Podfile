# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # tflite_flutter 0.12.x uses DynamicLibrary.process() which wraps
  # dlsym(RTLD_DEFAULT, ...). For iOS that only finds symbols in libraries
  # Runner itself directly links (LC_LOAD_DYLIB in Runner's Mach-O).
  #
  # The plugin already declares a TensorFlowLiteSwift/CoreML = 2.12.0
  # dependency, but the Swift pod only pulls TensorFlowLiteC in as a
  # transitive / lazy dep — dyld does not load the C framework eagerly,
  # so `TfLiteModelCreate` is missing from RTLD_DEFAULT.
  #
  # Adding TensorFlowLiteC 2.12 directly to Runner forces CocoaPods to
  # add it to Runner's Link Binary With Libraries phase, inserting an
  # `LC_LOAD_DYLIB @rpath/TensorFlowLiteC.framework/TensorFlowLiteC` in
  # the Runner binary. dyld then loads it at launch and its C symbols
  # become discoverable via dlsym(RTLD_DEFAULT, ...).
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # Must match the version tflite_flutter's podspec pins
  # (TensorFlowLiteSwift/CoreML = 2.12.0).
  pod 'TensorFlowLiteC', '2.12.0'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_LOCATION=1',
        'PERMISSION_LOCATION_WHEN_IN_USE=1',
        'PERMISSION_LOCATION_ALWAYS=1',
      ]
    end
  end

  # tflite_flutter uses DynamicLibrary.process() -> dlsym(RTLD_DEFAULT, ...)
  # to resolve TFLite C symbols at runtime. TensorFlowLiteC ships as a
  # STATIC vendored framework, so its symbols get linked into Runner by the
  # Swift wrapper — but Xcode's Release build strips them from the dynamic
  # symbol table, making dlsym fail with:
  #   "Failed to lookup symbol 'TfLiteModelCreate'".
  #
  # Fix: on the Runner target
  #   0. Compile Runner/TFLiteSymbolKeepalive.m (explicit C references to
  #      every TFLite symbol tflite_flutter calls) so the linker keeps them.
  #   1. Disable symbol stripping (STRIP_*, DEAD_CODE_STRIPPING, COPY_PHASE_STRIP)
  #   2. Pass `-Wl,-export_dynamic` so the linker keeps ALL global symbols
  #      in the main executable's exported symbol table.
  #   3. Pass `-Wl,-u,_<symbol>` for critical TFLite C symbols so the
  #      linker can never drop them even in aggressive LTO.
  #   4. Use `-force_load` on the static framework binary to pull every
  #      object file into Runner regardless of reachability.
  installer.aggregate_targets.each do |aggregate_target|
    next unless aggregate_target.name == 'Pods-Runner'
    user_project = aggregate_target.user_project
    user_project.native_targets.each do |runner_target|
      next unless runner_target.name == 'Runner'

      # --- (0) Add TFLiteSymbolKeepalive.m to Runner's Compile Sources ---
      keepalive_rel = 'Runner/TFLiteSymbolKeepalive.m'
      keepalive_abs = File.expand_path(keepalive_rel, File.dirname(__FILE__))
      if File.exist?(keepalive_abs)
        already_added = runner_target.source_build_phase.files_references.any? do |fr|
          fr && fr.path && fr.path.end_with?('TFLiteSymbolKeepalive.m')
        end
        unless already_added
          runner_group = user_project.main_group['Runner'] || user_project.main_group
          file_ref = runner_group.new_reference(keepalive_abs)
          runner_target.add_file_references([file_ref])
        end
      end

      runner_target.build_configurations.each do |config|
        config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'NO'
        config.build_settings['STRIP_STYLE'] = 'debugging'
        config.build_settings['DEPLOYMENT_POSTPROCESSING'] = 'NO'
        config.build_settings['DEAD_CODE_STRIPPING'] = 'NO'
        config.build_settings['COPY_PHASE_STRIP'] = 'NO'

        ldflags = config.build_settings['OTHER_LDFLAGS'] || ['$(inherited)']
        ldflags = [ldflags] if ldflags.is_a?(String)
        joined = ldflags.join(' ')

        # Force-load the static framework binary so every object is linked.
        fl = '-force_load "${PODS_ROOT}/TensorFlowLiteC/Frameworks/TensorFlowLiteC.framework/TensorFlowLiteC"'
        ldflags << fl unless joined.include?('TensorFlowLiteC/TensorFlowLiteC')

        # Export every global symbol (including ones from static libs) so
        # dlsym(RTLD_DEFAULT) can see them.
        ldflags << '-Wl,-export_dynamic' unless joined.include?('-export_dynamic')

        # Pin the specific TFLite C symbols tflite_flutter looks up so the
        # linker never drops them under LTO / dead-strip.
        %w[
          _TfLiteModelCreate
          _TfLiteModelCreateFromFile
          _TfLiteModelDelete
          _TfLiteInterpreterOptionsCreate
          _TfLiteInterpreterOptionsDelete
          _TfLiteInterpreterOptionsSetNumThreads
          _TfLiteInterpreterCreate
          _TfLiteInterpreterDelete
          _TfLiteInterpreterAllocateTensors
          _TfLiteInterpreterGetInputTensorCount
          _TfLiteInterpreterGetInputTensor
          _TfLiteInterpreterGetOutputTensorCount
          _TfLiteInterpreterGetOutputTensor
          _TfLiteInterpreterInvoke
          _TfLiteTensorType
          _TfLiteTensorNumDims
          _TfLiteTensorDim
          _TfLiteTensorByteSize
          _TfLiteTensorData
          _TfLiteTensorName
          _TfLiteTensorCopyFromBuffer
          _TfLiteTensorCopyToBuffer
          _TfLiteVersion
        ].each do |sym|
          flag = "-Wl,-u,#{sym}"
          ldflags << flag unless joined.include?(flag)
        end

        config.build_settings['OTHER_LDFLAGS'] = ldflags
      end
    end
    aggregate_target.user_project.save
  end
end
